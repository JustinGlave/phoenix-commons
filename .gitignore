# ── Phoenix-commons .gitignore ──────────────────────────────────────────────
# Required by Phase 1A:
#   __pycache__/, *.pyc, .pytest_cache/, *.egg-info/, build/, dist/, .venv/
# Plus common adjacent ignores so a fresh checkout stays clean.

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtualenv / environment
.venv/
venv/
env/

# Build / packaging artifacts
build/
dist/
*.egg-info/
*.egg

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
htmlcov/

# IDE / editor
.idea/
.vscode/

# OS noise
.DS_Store
Thumbs.db

# Logs and local scratch
*.log
