/* 
   Phoenix Controls Unified Design System - QSS Stylesheet
   Dark Modern Theme with Blue & Red Brand Colors
   Windows Target
*/

/* ============================================================================
   COLOR VARIABLES & ROOT STYLING
   ============================================================================ */

QMainWindow {
    background-color: #0a0e27;
    color: #ffffff;
}

QWidget {
    color: #ffffff;
}

/* ============================================================================
   WINDOW CHROME & FRAMES
   ============================================================================ */

QMenuBar {
    background-color: #0a0e27;
    color: #ffffff;
    border-bottom: 1px solid #2d3748;
    padding: 4px 0px;
    spacing: 16px;
}

QMenuBar::item:selected {
    background-color: #1f2937;
    color: #3b82f6;
}

QMenuBar::item:pressed {
    background-color: #1e3a8a;
}

QMenu {
    background-color: #141829;
    color: #ffffff;
    border: 1px solid #2d3748;
    border-radius: 4px;
    padding: 4px 0px;
}

QMenu::item:selected {
    background-color: #1f2937;
    color: #3b82f6;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
}

QMenu::item:pressed {
    background-color: #1e3a8a;
}

QMenu::separator {
    background-color: #2d3748;
    height: 1px;
    margin: 4px 0px;
}

/* ============================================================================
   BUTTONS
   ============================================================================ */

QPushButton {
    background-color: #dc2626;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    font-weight: 600;
    font-size: 14px;
    font-family: "Segoe UI", sans-serif;
}

QPushButton:hover {
    background-color: #b91c1c;
}

QPushButton:pressed {
    background-color: #991b1b;
}

QPushButton:focus {
    outline: none;
    border: 2px solid #3b82f6;
}

QPushButton:disabled {
    background-color: #4b5563;
    color: #6b7280;
}

/* Secondary Button (Alternate style) */
QPushButton#secondaryButton {
    background-color: #1e3a8a;
}

QPushButton#secondaryButton:hover {
    background-color: #1e40af;
}

QPushButton#secondaryButton:pressed {
    background-color: #1e3a8a;
}

/* Tertiary Button (Outline style) */
QPushButton#tertiaryButton {
    background-color: transparent;
    border: 1px solid #4b5563;
    color: #3b82f6;
}

QPushButton#tertiaryButton:hover {
    background-color: #1f2937;
    border: 1px solid #3b82f6;
}

/* ============================================================================
   LINE EDITS & TEXT INPUTS
   ============================================================================ */

QLineEdit {
    background-color: #141829;
    color: #ffffff;
    border: 1px solid #2d3748;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
    font-family: "Segoe UI", sans-serif;
    selection-background-color: #3b82f6;
}

QLineEdit:focus {
    border: 2px solid #3b82f6;
    background-color: #141829;
}

QLineEdit::placeholder {
    color: #9ca3af;
}

QLineEdit:disabled {
    background-color: #050810;
    color: #6b7280;
    border: 1px solid #2d3748;
}

/* ============================================================================
   TEXT EDITS & MULTI-LINE
   ============================================================================ */

QTextEdit, QPlainTextEdit {
    background-color: #141829;
    color: #ffffff;
    border: 1px solid #2d3748;
    border-radius: 6px;
    padding: 10px 12px;
    font-size: 14px;
    font-family: "Segoe UI", sans-serif;
    selection-background-color: #3b82f6;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #3b82f6;
}

QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #050810;
    color: #6b7280;
}

/* ============================================================================
   COMBO BOX / DROPDOWN
   ============================================================================ */

QComboBox {
    background-color: #141829;
    color: #ffffff;
    border: 1px solid #2d3748;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    font-family: "Segoe UI", sans-serif;
}

QComboBox:focus {
    border: 2px solid #3b82f6;
}

QComboBox:disabled {
    background-color: #050810;
    color: #6b7280;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

QComboBox::down-arrow {
    image: none;
    color: #9ca3af;
}

QComboBox QAbstractItemView {
    background-color: #141829;
    color: #ffffff;
    selection-background-color: #3b82f6;
    border: 1px solid #2d3748;
    outline: none;
}

/* ============================================================================
   CHECKBOXES
   ============================================================================ */

QCheckBox {
    color: #ffffff;
    spacing: 8px;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #4b5563;
    background-color: #141829;
}

QCheckBox::indicator:hover {
    border: 1px solid #3b82f6;
    background-color: #1f2937;
}

QCheckBox::indicator:checked {
    background-color: #dc2626;
    border: 1px solid #dc2626;
    image: url(:/icons/check.png);
}

QCheckBox::indicator:focus {
    border: 2px solid #3b82f6;
}

/* ============================================================================
   RADIO BUTTONS
   ============================================================================ */

QRadioButton {
    color: #ffffff;
    spacing: 8px;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #4b5563;
    background-color: #141829;
}

QRadioButton::indicator:hover {
    border: 1px solid #3b82f6;
    background-color: #1f2937;
}

QRadioButton::indicator:checked {
    background-color: #1e3a8a;
    border: 1px solid #1e3a8a;
}

QRadioButton::indicator:focus {
    border: 2px solid #3b82f6;
}

/* ============================================================================
   SPINBOX & DOUBLE SPINBOX
   ============================================================================ */

QSpinBox, QDoubleSpinBox {
    background-color: #141829;
    color: #ffffff;
    border: 1px solid #2d3748;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #3b82f6;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #050810;
    border: none;
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #1f2937;
}

/* ============================================================================
   LABELS
   ============================================================================ */

QLabel {
    color: #ffffff;
    font-size: 14px;
    font-family: "Segoe UI", sans-serif;
}

QLabel#title {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#sectionTitle {
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#subtitle {
    font-size: 14px;
    font-weight: 500;
    color: #d1d5db;
}

QLabel#hint {
    font-size: 12px;
    color: #9ca3af;
}

/* ============================================================================
   TABLES
   ============================================================================ */

QTableWidget, QTableView {
    background-color: #141829;
    alternate-background-color: #0f1219;
    gridline-color: #2d3748;
    border: 1px solid #2d3748;
    border-radius: 6px;
}

QTableWidget::item, QTableView::item {
    padding: 8px 12px;
    color: #ffffff;
    border: none;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #1e40af;
    color: #ffffff;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #1f2937;
}

QHeaderView::section {
    background-color: #050810;
    color: #e5e7eb;
    padding: 10px 12px;
    border: none;
    border-right: 1px solid #2d3748;
    border-bottom: 1px solid #2d3748;
    font-weight: 600;
    font-size: 13px;
}

QHeaderView::section:hover {
    background-color: #1f2937;
}

/* ============================================================================
   TREE WIDGET / LIST WIDGET
   ============================================================================ */

QTreeWidget, QListWidget {
    background-color: #141829;
    alternate-background-color: #0f1219;
    border: 1px solid #2d3748;
    border-radius: 6px;
    gridline-color: #2d3748;
}

QTreeWidget::item, QListWidget::item {
    padding: 8px 12px;
    color: #ffffff;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #1e40af;
    color: #ffffff;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: #1f2937;
}

QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: url(:/icons/chevron-right.png);
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: url(:/icons/chevron-down.png);
}

/* ============================================================================
   SCROLLBARS
   ============================================================================ */

QScrollBar:vertical {
    background-color: #0a0e27;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #4b5563;
    border-radius: 6px;
    margin: 0px 2px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6b7280;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    background-color: #0a0e27;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #4b5563;
    border-radius: 6px;
    margin: 2px 0px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6b7280;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* ============================================================================
   DIALOGS & GROUPBOXES
   ============================================================================ */

QGroupBox {
    color: #ffffff;
    border: 1px solid #2d3748;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    font-weight: 600;
    font-size: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 4px;
}

QDialog {
    background-color: #0a0e27;
}

QMessageBox QLabel {
    color: #ffffff;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* ============================================================================
   TABS
   ============================================================================ */

QTabWidget::pane {
    border: 1px solid #2d3748;
    background-color: #141829;
}

QTabBar::tab {
    background-color: #050810;
    color: #9ca3af;
    padding: 10px 16px;
    border: 1px solid #2d3748;
    border-bottom: none;
    font-size: 14px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #141829;
    color: #ffffff;
    border-bottom: 3px solid #dc2626;
}

QTabBar::tab:hover {
    background-color: #1f2937;
    color: #d1d5db;
}

/* ============================================================================
   SLIDER
   ============================================================================ */

QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background-color: #2d3748;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #3b82f6;
    border: none;
    width: 18px;
    margin: -6px 0px;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #60a5fa;
}

QSlider::sub-page:horizontal {
    background-color: #dc2626;
    border-radius: 3px;
}

/* ============================================================================
   PROGRESS BAR
   ============================================================================ */

QProgressBar {
    border: 1px solid #2d3748;
    border-radius: 6px;
    background-color: #050810;
    height: 20px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #dc2626;
    border-radius: 4px;
}

/* ============================================================================
   STATUS BAR
   ============================================================================ */

QStatusBar {
    background-color: #050810;
    color: #d1d5db;
    border-top: 1px solid #2d3748;
    padding: 4px 12px;
}

/* ============================================================================
   DOCKWIDGET
   ============================================================================ */

QDockWidget {
    color: #ffffff;
    font-weight: 600;
    border: 1px solid #2d3748;
}

QDockWidget::title {
    background-color: #050810;
    padding: 8px 12px;
    border-bottom: 1px solid #2d3748;
}

/* ============================================================================
   SPLITTER
   ============================================================================ */

QSplitter::handle {
    background-color: #2d3748;
}

QSplitter::handle:hover {
    background-color: #3b82f6;
}

/* ============================================================================
   FRAME
   ============================================================================ */

QFrame {
    border: 1px solid #2d3748;
    background-color: #141829;
    border-radius: 6px;
}

QFrame#card {
    border-radius: 8px;
    padding: 16px;
}

/* ============================================================================
   TOOLTIPS
   ============================================================================ */

QToolTip {
    background-color: #141829;
    color: #ffffff;
    border: 1px solid #2d3748;
    padding: 8px 12px;
    border-radius: 4px;
}

/* ============================================================================
   UTILITY CLASSES
   ============================================================================ */

QWidget#mainContent {
    background-color: #0a0e27;
    padding: 16px;
}

QWidget#statusBadge {
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: 600;
    font-size: 12px;
}

QWidget#statusBadge_success {
    background-color: #10b981;
    color: #ffffff;
}

QWidget#statusBadge_warning {
    background-color: #f59e0b;
    color: #ffffff;
}

QWidget#statusBadge_error {
    background-color: #ef4444;
    color: #ffffff;
}

QWidget#statusBadge_info {
    background-color: #0891b2;
    color: #ffffff;
}
